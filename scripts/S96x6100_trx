#!/bin/sh
#
# S96x6100_trx - start x6100_trx at boot instead of the GUI, on OpenX6X00 (2026-11-07)
#
# Only when /etc/x6100/boot.trx exists (x6100_ui.sh boot trx; x6100_ui.sh boot gui
# removes it): runs after S95gui, stops the GUI loop with x6100_ui.sh stop (which also
# starts the wfserver watcher), then x6100_trx detached, its output in /tmp/x6100_trx.log.
# When x6100_trx quits (PWR 1.5-4 s, quit) the GUI comes back (x6100_ui.sh start), so
# the radio is never left with a dark screen. Not on power off (PWR held 4 s: x6100_trx
# leaves /tmp/x6100_trx.poweroff) nor after stop (also run at shutdown). No file of the
# image is changed: this script is ours.
#
# What it decides goes into OpenX6X00's start trace (/mnt/app_logs/start_trace.txt) and
# into /tmp/x6100_trx.log, so a boot that brings the GUI shows why.
#
# Installed by build.sh deploy as /etc/init.d/S96x6100_trx. Busybox sh: POSIX only.
#

readonly C_FLAG="/etc/x6100/boot.trx"
readonly C_UI="/root/x6100_ui.sh"
readonly C_TRX="/root/x6100_trx"
readonly C_LOG="/tmp/x6100_trx.log"
readonly C_PID="/var/run/x6100_trx_boot.pid"
readonly C_TRACE="/usr/sbin/x6100-starttrace"
readonly C_DOWN="/tmp/x6100_trx.poweroff"	# there: x6100_trx ended for power off or stop, no GUI

#
# Say what is done: the start trace (when there), the log, the console
#

boot_say() {
	if [ -x "${C_TRACE}" ]; then
		"${C_TRACE}" "S96x6100_trx: $1" 2> /dev/null || true
	fi

	printf '%s %s\n' "$(date -u '+%Y-%m-%d %H:%M:%SZ')" "S96x6100_trx: $1" >> "${C_LOG}" 2> /dev/null || true
	printf '%s\n' "x6100_trx: $1"
}

#
# Start x6100_trx in place of the GUI, when chosen
#

boot_start() {
	if [ ! -f "${C_FLAG}" ]; then
		boot_say "${C_FLAG} not there: the GUI stays"
		return 0
	fi

	if [ ! -x "${C_TRX}" ] || [ ! -x "${C_UI}" ]; then
		boot_say "${C_TRX} or ${C_UI} missing or not executable: the GUI stays"
		return 0
	fi

	rm -f "${C_DOWN}"
	boot_say "stopping the GUI, starting ${C_TRX}"
	"${C_UI}" stop >> "${C_LOG}" 2>&1 || true

	# A detached shell runs x6100_trx and brings the GUI back when it quits (not on power off)
	setsid sh -c "\"${C_TRX}\" >> \"${C_LOG}\" 2>&1 < /dev/null; [ -e \"${C_DOWN}\" ] || \"${C_UI}\" start > /dev/null 2>&1" \
		< /dev/null > /dev/null 2>&1 &
	printf '%s\n' "$!" > "${C_PID}"
	boot_say "started"
}

#
# Stop x6100_trx (it saves its state on SIGTERM); also run at shutdown, so no GUI after it
#

boot_stop() {
	if pidof x6100_trx > /dev/null 2>&1; then
		: > "${C_DOWN}"
		boot_say "stopping x6100_trx"
		killall x6100_trx 2> /dev/null || true
	fi

	rm -f "${C_PID}"
}

case "${1:-}" in
	start)
		boot_start
		;;
	stop)
		boot_stop
		;;
	restart)
		boot_stop
		sleep 1
		boot_start
		;;
	*)
		printf 'usage: %s start|stop|restart\n' "$0" >&2
		exit 1
		;;
esac
