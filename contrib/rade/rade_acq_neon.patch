+#if defined(__ARM_NEON) || defined(__ARM_NEON__)
+/* Sum of the four lanes (no vaddvq_f32 on ARMv7) */
+static float acq_hsum(float32x4_t v) {
+    float32x2_t s = vadd_f32(vget_low_f32(v), vget_high_f32(v));
+    return vget_lane_f32(vpadd_f32(s, s), 0);
+}
+#endif
+
+/* conj(x) . p over n samples, with x and p split into real and imaginary arrays:
+   re = sum(xr*pr + xi*pi), im = sum(xr*pi - xi*pr). Split arrays let the dot
+   product run on NEON, eight samples a step in eight independent running sums
+   (one per product and half step), so the multiply-adds overlap instead of
+   waiting for each other; the result equals the complex loop up to the order
+   of the float additions. */
+static RADE_COMP acq_dot_conj(const float *xr, const float *xi,
+                              const float *pr, const float *pi, int n) {
+    float re = 0.0f, im = 0.0f;
+    int k = 0;
+
+#if defined(__ARM_NEON) || defined(__ARM_NEON__)
+    float32x4_t ac0 = vdupq_n_f32(0.0f), bd0 = ac0, ad0 = ac0, bc0 = ac0;
+    float32x4_t ac1 = ac0, bd1 = ac0, ad1 = ac0, bc1 = ac0;
+
+    for (; k + 8 <= n; k += 8) {
+        float32x4_t a0 = vld1q_f32(&xr[k]), a1 = vld1q_f32(&xr[k + 4]);
+        float32x4_t b0 = vld1q_f32(&xi[k]), b1 = vld1q_f32(&xi[k + 4]);
+        float32x4_t c0 = vld1q_f32(&pr[k]), c1 = vld1q_f32(&pr[k + 4]);
+        float32x4_t d0 = vld1q_f32(&pi[k]), d1 = vld1q_f32(&pi[k + 4]);
+
+        ac0 = vmlaq_f32(ac0, a0, c0);
+        bd0 = vmlaq_f32(bd0, b0, d0);
+        ad0 = vmlaq_f32(ad0, a0, d0);
+        bc0 = vmlaq_f32(bc0, b0, c0);
+        ac1 = vmlaq_f32(ac1, a1, c1);
+        bd1 = vmlaq_f32(bd1, b1, d1);
+        ad1 = vmlaq_f32(ad1, a1, d1);
+        bc1 = vmlaq_f32(bc1, b1, c1);
+    }
+
+    re = acq_hsum(vaddq_f32(vaddq_f32(ac0, ac1), vaddq_f32(bd0, bd1)));
+    im = acq_hsum(vsubq_f32(vaddq_f32(ad0, ad1), vaddq_f32(bc0, bc1)));
+#endif
+
+    for (; k < n; k++) {
+        re += xr[k] * pr[k] + xi[k] * pi[k];
+        im += xr[k] * pi[k] - xi[k] * pr[k];
+    }
+
+    RADE_COMP out = { re, im };
+    return out;
+}
